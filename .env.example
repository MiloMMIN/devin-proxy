# Devin 上游 session token（token 来源链第一级；也可由 token 文件或本地
# Devin Desktop 的 state.vscdb 自动提供，三者全无时启动报错）
DEVIN_API_KEY=

# 反代监听地址与端口
HOST=127.0.0.1
PORT=3000

# 可选：客户端访问 /v1/* 端点所需的 API key
# （Authorization: Bearer <key> 或 x-api-key: <key>）；不设置则不鉴权
PROXY_API_KEY=

# 可选：覆盖 Devin 上游 API 地址（默认 https://server.codeium.com）
DEVIN_BASE_URL=

# token 文件与配置目录（默认 ~/.devin-proxy，token 存于其中的 token 文件）
DEVIN_PROXY_CONFIG_DIR=

# 可选：显式指定 Devin Desktop state.vscdb 路径（默认按平台自动定位）
DEVIN_DESKTOP_STATE_DB=

# 模型别名映射：客户端模型 id → 上游模型 uid，逗号分隔，两端自动 trim
# 例：MODEL_MAP=fast=glm-5-2-none,claude=claude-opus-4-8-max
MODEL_MAP=

# 上游模型列表缓存 TTL（毫秒，默认 600000 即 10 分钟）
MODELS_TTL_MS=600000

# 日志级别：debug | info | warn | error（默认 info，输出到 stderr）
LOG_LEVEL=info
